# Copy to apps/api/.env for local development. Every variable is validated at startup
# (src/config/env.ts); the process refuses to start with a missing or malformed value.

NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Public origin of the web app (verify links and QR codes point here).
PUBLIC_APP_URL=http://localhost:5173
# Extra origins allowed by CORS, comma-separated. Usually empty: the web app proxies /api.
CORS_ORIGINS=

# docker-compose Postgres
DATABASE_URL=postgresql://certdrop:certdrop@localhost:5432/certdrop

# docker-compose RustFS (S3-compatible). For Cloudflare R2 use https://<account-id>.r2.cloudflarestorage.com,
# S3_REGION=auto and S3_FORCE_PATH_STYLE=false.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=certdrop
S3_ACCESS_KEY_ID=certdrop
S3_SECRET_ACCESS_KEY=certdrop-dev-secret
S3_FORCE_PATH_STYLE=true

# Reverse proxies in front of the API. 0 locally; 2 behind Vercel (rewrite) + Render.
TRUST_PROXY_HOPS=0

# Development-only secrets. Generate real ones for every deployed environment:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
OTP_SECRET=dev-only-otp-secret-change-me-0123456789abc

# "file" writes emails to MAIL_OUTBOX_DIR (relative to apps/api) instead of sending them.
# Production: EMAIL_PROVIDER=resend, RESEND_API_KEY=re_..., and an address on a verified domain.
EMAIL_PROVIDER=file
MAIL_OUTBOX_DIR=.mail-outbox
EMAIL_FROM_ADDRESS=certificates@certdrop.local
# RESEND_API_KEY=
# Resend dashboard → Webhooks → signing secret. Enables delivery/bounce tracking.
# RESEND_WEBHOOK_SECRET=whsec_...
# Sends per second (Resend's default limit is 2) and parallel PDF renders per worker.
EMAIL_RATE_PER_SECOND=2
GENERATE_CONCURRENCY=3

# Cloudflare Turnstile. These are Cloudflare's public always-pass TEST keys, so the widget and
# server check run locally. Required (with real keys) in production.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Per-organizer caps per rolling 24 hours, and how long template/PDF files are kept.
BATCHES_PER_DAY=10
TEMPLATES_PER_DAY=30
FILE_RETENTION_DAYS=30
